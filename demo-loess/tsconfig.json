{
   "compilerOptions": {
      "allowUnreachableCode": false,
      "baseUrl": "src",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ES2020",
      "moduleResolution": "bundler",
      "noFallthroughCasesInSwitch": true,
      "noImplicitAny": true,
      "noImplicitOverride": true,
      "noImplicitReturns": true,
      "noImplicitThis": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "outDir": "tempBuild",
      "paths": {
         "commons-math-interpolation/*": ["../../dist/*"]
      },
      "removeComments": true,
      "strict": true,
      "target": "ES2020"
   },
   "include": ["src"]
}
