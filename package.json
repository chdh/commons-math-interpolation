{
   "name": "Commons Math Interpolation – Akima, Cubic Spline and LOESS for TypeScript",
   "version": "2.2.5",
   "description": "Akima cubic spline, natural cubic spline, linear and nearest neighbor interpolation, and LOESS/LOWESS local regression. A partial TypeScript port of the Apache Commons Math interpolation classes.",
   "type": "module",
   "main": "./dist/Index.js",
   "types": "./dist/Index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/Index.d.ts",
         "default": "./dist/Index.js"
      },
      "./*": {
         "types": "./dist/*.d.ts",
         "default": "./dist/*.js"
      }
   },
   "files": [
      "dist/"
   ],
   "keywords": [
      "math",
      "interpolation",
      "spline",
      "cubic spline",
      "natural cubic spline",
      "akima",
      "akima spline",
      "linear interpolation",
      "nearest neighbor",
      "loess",
      "lowess",
      "local regression",
      "smoothing",
      "curve fitting",
      "apache commons math"
   ],
   "license": "MIT",
   "homepage": "https://github.com/chdh/commons-math-interpolation",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/chdh/commons-math-interpolation.git"
   },
   "contributors": [
      {
         "name": "Christian d'Heureuse",
         "email": "chdh@inventec.ch",
         "url": "https://www.source-code.biz"
      }
   ],
   "scripts": {
      "clean": "node build.js clean",
      "build": "node build.js build"
   },
   "sideEffects": false
}
