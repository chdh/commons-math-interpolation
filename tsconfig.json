{
   "compilerOptions": {
      "allowUnreachableCode": false,
      "declaration": true,
      "declarationDir": "dist",
      "declarationMap": true,
      "forceConsistentCasingInFileNames": true,
      "lib": ["ES2020"],
      "module": "node16",
      "noFallthroughCasesInSwitch": true,
      "noImplicitOverride": true,
      "noImplicitReturns": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "outDir": "dist",
      "removeComments": true,
      "rewriteRelativeImportExtensions": true,
      "rootDir": "src",
      "sourceMap": true,
      "strict": true,
      "target": "ES2020"
   },
   "include": ["src"]
}
